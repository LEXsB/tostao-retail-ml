<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {{ plotly_js | safe }}
  <style>
    :root {
      --coffee: #6F4E37; --coffee-2: #C68B59; --accent: #E4572E;
      --ink: #2B2118; --paper: #FFFFFF; --grid: #ECE5DE; --muted: #7F8C8D;
      --good: #2E9E5B; --warn: #E5A50A; --crit: #C0392B;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Inter, "Segoe UI", Helvetica, Arial, sans-serif;
           color: var(--ink); background: #FAF7F3; line-height: 1.55; }
    header.hero { background: linear-gradient(135deg, var(--coffee), var(--coffee-2));
                  color: #fff; padding: 2.4rem 2rem; }
    header.hero h1 { margin: 0 0 .3rem; font-size: 1.9rem; }
    header.hero p { margin: 0; opacity: .92; }
    .layout { display: grid; grid-template-columns: 250px 1fr; gap: 0; }
    nav.toc { position: sticky; top: 0; align-self: start; height: 100vh; overflow:auto;
              background: #fff; border-right: 1px solid var(--grid); padding: 1.2rem 1rem; }
    nav.toc h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em;
                 color: var(--muted); margin: .4rem 0; }
    nav.toc a { display: block; padding: .35rem .5rem; color: var(--ink); text-decoration: none;
                border-radius: 6px; font-size: .92rem; }
    nav.toc a:hover { background: var(--grid); }
    main { padding: 1.6rem 2.2rem; max-width: 1100px; }
    section.report-section { background: #fff; border: 1px solid var(--grid); border-radius: 12px;
              padding: 1.4rem 1.6rem; margin-bottom: 1.6rem; scroll-margin-top: 1rem; }
    section.report-section > h2 { margin-top: 0; color: var(--coffee); border-bottom: 2px solid var(--grid);
                    padding-bottom: .5rem; }
    .desc { color: #4a3f36; }
    .insights { list-style: none; padding: 0; margin: 1rem 0; }
    .insights li { padding: .55rem .8rem; border-radius: 8px; margin-bottom: .4rem;
                   border-left: 4px solid var(--muted); background: #FBF9F6; }
    .insights li.good { border-color: var(--good); }
    .insights li.info { border-color: var(--coffee-2); }
    .insights li.warning { border-color: var(--warn); }
    .insights li.critical { border-color: var(--crit); }
    .figure { margin: 1rem 0; }
    table.table { border-collapse: collapse; width: 100%; font-size: .88rem; margin: .8rem 0; }
    table.table th, table.table td { border: 1px solid var(--grid); padding: .4rem .6rem; text-align: right; }
    table.table th { background: #F3ECE4; color: var(--coffee); }
    footer { color: var(--muted); font-size: .82rem; padding: 1.5rem 2.2rem; }
    .badge { display:inline-block; padding:.1rem .5rem; border-radius:999px; font-size:.72rem;
             background: var(--grid); color: var(--coffee); margin-left:.4rem; }
  </style>
</head>
<body>
  <header class="hero">
    <h1>{{ title }}</h1>
    {% if subtitle %}<p>{{ subtitle }}</p>{% endif %}
  </header>
  <div class="layout">
    <nav class="toc">
      <h2>Índice</h2>
      {% for s in sections %}
      <a href="#{{ s.id }}">{{ loop.index }}. {{ s.title }}</a>
      {% endfor %}
    </nav>
    <main>
      {% for s in sections %}
      <section class="report-section" id="{{ s.id }}">
        <h2>{{ s.title }}
          {% if s.worst_severity %}<span class="badge">{{ s.worst_severity }}</span>{% endif %}
        </h2>
        {% if s.description %}<p class="desc">{{ s.description }}</p>{% endif %}
        {% if s.insights %}
        <ul class="insights">
          {% for ins in s.insights %}
          <li class="{{ ins.severity }}">{{ ins.emoji }}
            {% if ins.title %}<strong>{{ ins.title }}</strong> — {% endif %}{{ ins.text }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% for name, div in s.figures.items() %}
        <div class="figure">{{ div | safe }}</div>
        {% endfor %}
        {% for name, html in s.tables.items() %}
        <div class="table-wrap"><h3>{{ name }}</h3>{{ html | safe }}</div>
        {% endfor %}
      </section>
      {% endfor %}
    </main>
  </div>
  <footer>{{ footer }}</footer>
</body>
</html>
